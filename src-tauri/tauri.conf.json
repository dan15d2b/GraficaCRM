{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "crmgrafica",
  "version": "2.0.0",
  "identifier": "br.com.crmgrafica",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter frontend-node dev",
    "beforeBuildCommand": "pnpm --filter frontend-node build",
    "frontendDist": "../frontend-node/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CRM Gráfica",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 (>= 2.40)",
          "libgtk-3-0 (>= 3.24)"
        ]
      }
    }
  }
}