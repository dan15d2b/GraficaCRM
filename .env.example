# CRM Gráfica 2.0 - Environment Variables
# Copy para .env.local e preencha os valores

# ====================
# Database
# ====================
DATABASE_URL="file:./data/app.db"

# ====================
# License Server (VPS Admin Panel)
# ====================
LICENSE_SERVER_URL="https://licencas.graficacrm.com"

# ====================
# Auth (JWT)
# ====================
JWT_SECRET="GERAR_COM: openssl rand -hex 32"
JWT_EXPIRES_IN="7d"

# ====================
# AI Providers (escolha uma)
# ====================
# OPENROUTER_API_KEY="sk-or-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."

# ====================
# Server
# ====================
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"

# ====================
# Sentry (opcional)
# ====================
# SENTRY_DSN=""

# ====================
# Tauri (development)
# ====================
# VITE_TAURI_PORT=1433