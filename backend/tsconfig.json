{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "plugins": [
      {
        "name": "html-modules"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/lib/db/local": ["./src/lib/db/local.ts"],
      "@/lib/auth/local": ["./src/lib/auth/local.ts"],
      "@/lib/logger": ["./src/lib/logger.ts"],
      "@/lib/api/wrappers": ["./src/lib/api/wrappers.ts"],
      "@/lib/license/client": ["./src/lib/license/client.ts"],
      "@/lib/env": ["./src/lib/env.ts"]
    },
    "outDir": "./dist"
  },
  "include": [
    "src/**/*",
    "lib/**/*",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    "tests/**",
    "src-tauri"
  ]
}