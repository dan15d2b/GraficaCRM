#!/bin/bash
# ==========================================
# CRMGráfica 2.0 — Setup para HostGator
# ==========================================

echo "╔════════════════════════════════════════════════════╗"
echo "║      CRMGráfica 2.0 — Setup HostGator               ║"
echo "╚════════════════════════════════════════════════════╝"
echo ""

# Cores
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}📋 PASSO A PASSO PARA HOSTGATOR:${NC}"
echo ""

echo "1️⃣  ACESSAR cPanel da HostGator"
echo "   - Acesse: https://suaconta.hostgator.com.br/cpanel"
echo ""

echo "2️⃣  CONFIGURAR BANCO DE DADOS"
echo "   - vá em: Bancos de Dados > MySQL"
echo "   - Criar banco: crmgrafica"
echo "   - Criar usuário: crmgrafica_user"
echo "   - Anotar: nome do banco, usuário e senha"
echo ""

echo "3️⃣  CONFIGURAR NODE.JS"
echo "   - vá em: Configurar Site > Node.js"
echo "   - Aplicaçãopresente: /home/usuario/crmgrafica-2.0"
echo "   - Modo: Produção"
echo "   - Framework: Next.js"
echo "   - Application mode:_production"
echo "   - Application startup file: None"
echo ""

echo "4️⃣  UPLOAD DOS ARQUIVOS"
echo "   - Use FTP ou File Manager do cPanel"
echo "   - Upload da pasta crmgrafica-2.0/"
echo "   - Extrair em: /home/usuario/"
echo ""

echo "5️⃣  CONFIGURAR VARIÁVEIS"
echo "   - No cPanel, vá em: Node.js"
echo "   - Edite as variáveis de ambiente:"
echo "     NODE_ENV=production"
echo "     DATABASE_URL=mysql://usuario:senha@localhost/crmgrafica"
echo "     NEXTAUTH_URL=https://seudominio.com"
echo "     NEXTAUTH_SECRET=seu-secret-aleatorio"
echo ""

echo "6️⃣  APLICAR MIGRATIONS"
echo "   - Acesse o terminal do cPanel"
echo "   - Execute:"
echo "     cd /home/usuario/crmgrafica-2.0"
echo "     npm run db:migrate"
echo ""

echo "7️⃣  REINICIAR APLICAÇÃO"
echo "   - No painel Node.js do cPanel"
echo "   - Clique em 'Restart'"
echo ""

echo -e "${YELLOW}⚠️  NOTAS IMPORTANTES:${NC}"
echo "   - HostGator não suporta PostgreSQL nativo"
echo "   - Use Supabase (PostgreSQL na nuvem)"
echo "   - Configure o SUPABASE_URL no cPanel"
echo "   - Ou use MySQL adaptando as migrations"
echo ""

echo -e "${GREEN}✅ Pronto! Acesse: https://seudominio.com${NC}"
