version: '3.8'

services:
  # Banco de Dados PostgreSQL
  postgres:
    image: postgres:16-alpine
    container_name: crmgrafica-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: crmgrafica
      POSTGRES_PASSWORD: grafica2024!
      POSTGRES_DB: crmgrafica
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - crmgrafica

  # API de Licenças (simulação)
  license-server:
    build: ./servers/license
    container_name: crmgrafica-license
    restart: unless-stopped
    ports:
      - "8080:8080"
    environment:
      DATABASE_URL: postgresql://crmgrafica:grafica2024!@postgres:5432/crmgrafica
    depends_on:
      - postgres
    networks:
      - crmgrafica

  # Aplicação Principal
  web:
    build: .
    container_name: crmgrafica-web
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      DATABASE_URL: postgresql://crmgrafica:grafica2024!@postgres:5432/crmgrafica
      NEXT_PUBLIC_SUPABASE_URL: http://localhost:3000
      NEXTAUTH_SECRET: sua-secret-aqui-mude-em-producao-32-caracteres-minimo
      NODE_ENV: production
    depends_on:
      - postgres
    networks:
      - crmgrafica

volumes:
  postgres_data:

networks:
  crmgrafica:
    driver: bridge
