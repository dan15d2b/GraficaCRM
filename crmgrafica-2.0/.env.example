# Este arquivo NÃO configura um app separado.
# As variáveis do CRMGráfica vivem no .env.local da RAIZ do repositório.
#
# Rode:
#   bash scripts/aplicar-marca.sh https://seu-dominio.duckdns.org
#
# Isso grava na raiz:
#   APP_NAME=CRMGráfica
#   APP_ACCENT_HEX=#2563EB
#   NEXT_PUBLIC_APP_URL=...
#
# Demais chaves (Supabase, INTERNAL_SECRET, WAHA): copie de ../.env.example
