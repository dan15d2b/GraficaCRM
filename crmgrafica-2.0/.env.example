# ==========================================
# CRMGráfica 2.0 — Variáveis de Ambiente
# ==========================================

# Banco de Dados
DATABASE_URL="postgresql://user:password@localhost:5432/crmgrafica"

# Autenticação
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="seu-secret-aqui-mude-em-producao"

# Licenciamento
LICENSE_SERVER_URL="https://licenca.crmgrafica.com.br/api/validate"
LICENSE_VALIDATION_INTERVAL="24"

# Branding (padrão azul profissional, sem verde)
APP_NAME="CRMGráfica"
APP_LOGO_URL=""
APP_ACCENT_HEX="#2563EB"

# IA / LLM
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-4"

# WhatsApp (WAHA)
WAHA_URL="http://localhost:3333"
WAHA_TOKEN="seu-token-waha"

# Segurança
ENCRYPTION_KEY="sua-chave-de-criptografia-32-caracteres"
INTERNAL_CRON_SECRET="seu-secret-interno"

# Produção
NODE_ENV="development"
